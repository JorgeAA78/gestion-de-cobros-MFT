{
  "name": "cobros-system-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n fe,be -c cyan,green \"pnpm --filter frontend dev\" \"pnpm --filter backend dev\"",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:server": "pnpm --filter backend dev",
    "build": "pnpm --filter frontend build",
    "build:server": "pnpm --filter backend build",
    "build:all": "pnpm run build && pnpm run build:server",
    "start": "pnpm --filter backend start",
    "lint": "pnpm --filter frontend lint"
  },
  "dependencies": {
    "concurrently": "^9.2.1"
  }
}
