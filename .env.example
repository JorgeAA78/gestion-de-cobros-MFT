# ─── Configuración del servidor ───────────────────────────────────────────────
PORT=3001

# ─── JWT Secret (cambiar en producción) ───────────────────────────────────────
JWT_SECRET=tu-clave-secreta-muy-segura-cambiar-en-produccion

# ─── EmailJS para envío de emails ──────────────────────────────────────────────
# Crear cuenta gratis en: https://www.emailjs.com/
# 1. Crear un Email Service (Gmail)
# 2. Crear un Email Template con variables: {{to_email}}, {{nombre}}, {{token}}
# 3. Habilitar "Allow EmailJS API for non-browser applications" en Security
EMAILJS_SERVICE_ID=service_xxxxx
EMAILJS_TEMPLATE_ID=template_xxxxx
EMAILJS_PUBLIC_KEY=tu-public-key

# ─── Entorno ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ─── YCloud API (WhatsApp) ────────────────────────────────────────────────────
YCLOUD_API_KEY=tu-ycloud-api-key
YCLOUD_WHATSAPP_NUMBER=tu-numero-remitente-ycloud
